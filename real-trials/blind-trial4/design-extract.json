  "design_extract": {
    "parse_status": "partial",
    "research_question": "藻菌颗粒污泥（MBGS）体系的构建及其脱氮效能，以及直接氨氧化菌强化脱氮机制与生物质回收利用",
    "research_goal_level": "unspecified",
    "hypotheses": [
      {
        "id": "H1",
        "text": "不同初始条件（接种方式/藻种添加）构建的MBGS体系在脱氮效能、胞外聚合物特征及微生物菌群组成上存在差异，且能形成长期稳定运行的体系",
        "expected_conclusion": "原生藻种和投加斜生四链藻形成的MBGS优于投加小球藻",
        "status": "inferred",
        "locations": [
          {
            "source_file": "trial4.docx",
            "original_text": "通过培养不同初始条件下MBGS，明确胞外聚合物特征、微生物菌群组成的变化及相互之间的内在联系，构建得到长期稳定运行的相对较优的脱氮MBGS体系。",
            "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "paragraph_id": "p-82"
          }
        ]
      },
      {
        "id": "H2",
        "text": "直接氨氧化菌能够强化MBGS体系脱氮效能",
        "expected_conclusion": "直接氨氧化菌强化MBGS体系具有更高的脱氮能力并改变脱氮基因表达",
        "status": "inferred",
        "locations": [
          {
            "source_file": "trial4.docx",
            "original_text": "通过构建直接氨氧化菌强化MBGS脱氮体系，探究该体系的脱氮能力、微生物菌群组成的变化以及部分脱氮基因相对表达量变化，得到对城市污水高效脱氮的MBGS体系，并探究体系的藻菌互作机理",
            "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "paragraph_id": "p-83"
          }
        ]
      }
