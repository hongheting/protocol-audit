  "design_extract": {
    "parse_status": "ok",
    "research_question": "评价植物促生菌剂在不同水分条件和土壤背景下对玉米幼苗生长的影响，并探索根际EPS、土壤团聚体稳定性与植物响应之间的关系",
    "research_goal_level": "mechanism_exploratory",
    "hypotheses": [
      {
        "id": "H1",
        "text": "接种植物促生菌剂能够提高玉米幼苗生物量，并减轻干旱处理对生长的抑制作用",
        "expected_conclusion": "菌剂提高生物量，并减轻干旱抑制",
        "status": "stated",
        "locations": [
          {
            "source_file": "trial3.docx",
            "original_text": "H1：接种植物促生菌剂能够提高玉米幼苗生物量，并减轻干旱处理对生长的抑制作用。",
            "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "paragraph_id": "p-8"
          }
        ]
      },
      {
        "id": "H2",
        "text": "菌剂通过提高根际EPS水平和土壤团聚体稳定性改善土壤水分保持能力，进而促进玉米生长；EPS是该效应的主要作用机制",
        "expected_conclusion": "EPS介导促生机制，提高团聚体稳定性与水分保持",
        "status": "stated",
        "locations": [
          {
            "source_file": "trial3.docx",
            "original_text": "H2：菌剂通过提高根际 EPS 水平和土壤团聚体稳定性改善土壤水分保持能力，进而促进玉米生长；EPS 是该效应的主要作用机制。",
            "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "paragraph_id": "p-9"
          }
        ]
      },
      {
        "id": "H3",
        "text": "菌剂在退化黄土和参考农田土壤中均能产生稳定的促生效果，28 d 盆栽结果可为退化旱地的推广应用提供依据",
        "expected_conclusion": "两种土壤均有效，具应用潜力",
        "status": "stated",
        "locations": [
          {
            "source_file": "trial3.docx",
            "original_text": "H3：菌剂在退化黄土和参考农田土壤中均能产生稳定的促生效果，28 d 盆栽结果可为退化旱地的推广应用提供依据。",
            "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "paragraph_id": "p-10"
          }
        ]
      }
